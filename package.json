{
  "name": "@local/dsh-copy-image-menu",
  "version": "1.0.0",
  "description": "Click an assistant copy button to copy Markdown or download a PNG image.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "gghyoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gghyoo/dsh-copy-image-menu.git"
  },
  "homepage": "https://github.com/gghyoo/dsh-copy-image-menu#readme",
  "bugs": {
    "url": "https://github.com/gghyoo/dsh-copy-image-menu/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "markdown",
    "png",
    "screenshot"
  ]
}
